# ─────────────────────────────────────────────────────────────────────
#  Quant Trading System — environment configuration
#  Copy this file to `.env` and fill in your values. `.env` is ignored
#  by git so credentials stay local.
# ─────────────────────────────────────────────────────────────────────

# ── LLM Analyst ──────────────────────────────────────────────────────
# Provider: none | ollama | huggingface | openrouter | openai | anthropic
LLM_PROVIDER=none

# Model id for the chosen provider. Examples:
#   ollama:      llama3, mistral, qwen2:7b
#   huggingface: mistralai/Mistral-7B-Instruct-v0.3
#   openrouter:  meta-llama/llama-3.1-8b-instruct, anthropic/claude-3.5-sonnet
#   openai:      gpt-4o-mini, gpt-4o
#   anthropic:   claude-3-5-sonnet-20241022
LLM_MODEL=

# API key (required for openai, anthropic, openrouter; optional for
# huggingface free tier). Ollama runs locally and needs no key.
LLM_API_KEY=
# Provider-specific key override (optional) — e.g. OPENAI_API_KEY, ANTHROPIC_API_KEY
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# HUGGINGFACE_API_KEY=

# Local / custom endpoint. Ollama uses http://localhost:11434 by default.
# LLM_BASE_URL=http://localhost:11434

# Sampling controls (optional)
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=512
# LLM_TIMEOUT=120

# Optional custom system prompt for the analyst (overrides the built-in one)
# LLM_SYSTEM_PROMPT=

# ── Dhan API (optional; sandbox mode uses yfinance instead) ──────────
# DHAN_CLIENT_ID=
# DHAN_ACCESS_TOKEN=
